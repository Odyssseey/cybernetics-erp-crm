<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_library" model="ir.module.category">
        <field name="name">Бібліотека</field>
    </record>

    <record id="privilege_library" model="res.groups.privilege">
        <field name="name">Доступ до бібліотеки</field>
        <field name="category_id" ref="module_category_library"/>
    </record>

    <record id="group_library_reader" model="res.groups">
        <field name="name">Читач</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_library"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_library_librarian" model="res.groups">
        <field name="name">Бібліотекар</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_library"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

    <record id="rule_library_loan_reader" model="ir.rule">
        <field name="name">Читач бачить лише власні видачі</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.set([ref('group_library_reader')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_library_loan_librarian" model="ir.rule">
        <field name="name">Бібліотекар бачить усі видачі</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.set([ref('group_library_librarian')])]"/>
    </record>
</odoo>
