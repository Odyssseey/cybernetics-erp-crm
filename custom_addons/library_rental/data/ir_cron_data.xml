<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="ir_cron_check_overdue_loans" model="ir.cron">
        <field name="name">Library: перевірка прострочених видач</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="user_id" ref="base.user_admin"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_overdue_loans()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.utcnow() - timedelta(hours=2) + timedelta(days=1)).replace(hour=2, minute=0, second=0, microsecond=0)"/>
    </record>
</odoo>
