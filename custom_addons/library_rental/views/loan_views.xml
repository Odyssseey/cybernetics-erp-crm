<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_library_loan_list" model="ir.ui.view">
        <field name="name">library.loan.list</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <list string="Видачі" decoration-danger="is_overdue">
                <field name="copy_id"/>
                <field name="book_name"/>
                <field name="member_id"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="fine_amount"/>
                <field name="state"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_library_loan_form" model="ir.ui.view">
        <field name="name">library.loan.form</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <form string="Видача">
                <sheet>
                    <group>
                        <group>
                            <field name="copy_id"/>
                            <field name="book_name"/>
                            <field name="book_author"/>
                            <field name="book_isbn"/>
                        </group>
                        <group>
                            <field name="member_id"/>
                            <field name="membership_number"/>
                        </group>
                        <group>
                            <field name="loan_date"/>
                            <field name="due_date"/>
                            <field name="return_date"/>
                            <field name="fine_amount"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_loan_search" model="ir.ui.view">
        <field name="name">library.loan.search</field>
        <field name="model">library.loan</field>
        <field name="arch" type="xml">
            <search string="Пошук видач">
                <field name="copy_id"/>
                <field name="member_id"/>
                <filter name="with_fine" string="Зі штрафом" domain="[('fine_amount', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <record id="action_library_loan" model="ir.actions.act_window">
        <field name="name">Видачі</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_library_loan_search"/>
    </record>

    <record id="view_library_my_loan_list" model="ir.ui.view">
        <field name="name">library.loan.my.list</field>
        <field name="model">library.loan</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list string="Мої видачі" create="0" edit="0" delete="0" decoration-danger="is_overdue">
                <field name="copy_id"/>
                <field name="book_name"/>
                <field name="loan_date"/>
                <field name="due_date"/>
                <field name="return_date"/>
                <field name="fine_amount"/>
                <field name="state"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_library_my_loan_form" model="ir.ui.view">
        <field name="name">library.loan.my.form</field>
        <field name="model">library.loan</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Моя видача" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="copy_id" options="{'no_open': True}"/>
                            <field name="book_name"/>
                            <field name="book_author"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="loan_date"/>
                            <field name="due_date"/>
                            <field name="return_date"/>
                            <field name="fine_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_my_loan_search" model="ir.ui.view">
        <field name="name">library.loan.my.search</field>
        <field name="model">library.loan</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <search string="Пошук моїх видач">
                <field name="copy_id"/>
                <filter name="with_fine" string="Зі штрафом" domain="[('fine_amount', '&gt;', 0)]"/>
            </search>
        </field>
    </record>

    <record id="action_library_my_loans" model="ir.actions.act_window">
        <field name="name">Мої видачі</field>
        <field name="res_model">library.loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('reader_user_id', '=', uid)]</field>
        <field name="search_view_id" ref="view_library_my_loan_search"/>
    </record>

    <record id="action_library_my_loans_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_library_my_loan_list"/>
        <field name="act_window_id" ref="action_library_my_loans"/>
    </record>

    <record id="action_library_my_loans_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_library_my_loan_form"/>
        <field name="act_window_id" ref="action_library_my_loans"/>
    </record>
</odoo>
